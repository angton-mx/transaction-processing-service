# Docker Compose development database
POSTGRES_DB=transaction_processing
POSTGRES_USER=transaction_processing
POSTGRES_PASSWORD=transaction_processing_dev
POSTGRES_PORT=5433

# Spring datasource
DB_URL=jdbc:postgresql://localhost:5433/transaction_processing
DB_USERNAME=transaction_processing
DB_PASSWORD=transaction_processing_dev

# External transaction provider (run a local stub on this port for manual use)
PROVIDER_BASE_URL=http://localhost:8081
